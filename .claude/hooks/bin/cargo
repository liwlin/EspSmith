#!/bin/bash
# Cargo wrapper for Claude Code on the web sessions.
#
# src-tauri/.cargo/config.toml replaces crates-io with the rsproxy.cn mirror,
# which is unreachable from the web sandbox. Cargo's [source] table cannot be
# overridden through environment variables, so this wrapper injects --config
# flags that point the replacement back at the official crates.io index.
# It is only put on PATH by .claude/hooks/session-start.sh in remote sessions;
# local development is unaffected.
set -euo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/cargo"
REAL=""
for candidate in $(type -ap cargo); do
  if [ "$candidate" != "$SELF" ]; then
    REAL="$candidate"
    break
  fi
done
if [ -z "$REAL" ]; then
  REAL="$HOME/.cargo/bin/cargo"
fi

exec "$REAL" \
  --config 'source.crates-io.replace-with="official"' \
  --config 'registries.official.index="sparse+https://index.crates.io/"' \
  "$@"
